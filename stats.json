name: Update Profile Stats JSON

on:
  schedule:
    - cron: '0 */12 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Fetch and Generate JSON
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITHUB_USERNAME: AnsBenO
        run: |
          cat << 'EOF' > get-stats.js

          const fs = require('fs');

          const API_URL = 'https://api.github.com';
          const GRAPHQL_URL = `${API_URL}/graphql`;

          const username = process.env.GITHUB_USERNAME;
          const token = process.env.GITHUB_TOKEN;

          const headers = {
            'Authorization': `Bearer ${token}`,
            'Accept': 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
            'User-Agent': 'profile-stats-updater'
          };

          async function githubRest(endpoint) {
            const response = await fetch(`${API_URL}${endpoint}`, {
              headers
            });

            if (!response.ok) {
              const text = await response.text();

              throw new Error(
                `GitHub REST API error ${response.status}: ${text}`
              );
            }

            return response.json();
          }

          async function githubGraphQL(query, variables = {}) {
            const response = await fetch(GRAPHQL_URL, {
              method: 'POST',

              headers: {
                ...headers,
                'Content-Type': 'application/json'
              },

              body: JSON.stringify({
                query,
                variables
              })
            });

            if (!response.ok) {
              const text = await response.text();

              throw new Error(
                `GitHub GraphQL API error ${response.status}: ${text}`
              );
            }

            const result = await response.json();

            if (result.errors) {
              throw new Error(
                `GraphQL Errors: ${JSON.stringify(result.errors)}`
              );
            }

            return result.data;
          }


          async function fetchUserStats() {

            const query = `
              query($username: String!) {

                user(login: $username) {

                  name

                  contributionsCollection {
                    totalCommitContributions
                    restrictedContributionsCount
                  }

                  pullRequests(first: 1) {
                    totalCount
                  }

                  issues(first: 1) {
                    totalCount
                  }

                  followers {
                    totalCount
                  }

                  repositories(
                    first: 100
                    ownerAffiliations: OWNER
                    orderBy: {
                      field: STARGAZERS
                      direction: DESC
                    }
                  ) {

                    nodes {

                      name
                      url
                      stargazerCount
                      forkCount
                      isPrivate
                      isFork

                      languages(
                        first: 5
                        orderBy: {
                          field: SIZE
                          direction: DESC
                        }
                      ) {

                        edges {
                          size

                          node {
                            name
                            color
                          }
                        }

                      }

                    }

                  }

                }

              }
            `;

            return githubGraphQL(query, {
              username
            });
          }


          async function fetchWeeklyCodeFrequency(repositories) {

            const weeklyStats = {};

            for (const repo of repositories) {

              if (repo.isPrivate || repo.isFork) {
                continue;
              }

              try {

                const data = await githubRest(
                  `/repos/${username}/${repo.name}/stats/code_frequency`
                );

                /*
                 * GitHub returns:
                 *
                 * [
                 *   [timestamp, additions, deletions],
                 *   ...
                 * ]
                 *
                 * Deletions are returned as negative numbers.
                 */

                if (!Array.isArray(data)) {
                  continue;
                }

                for (const week of data) {

                  const timestamp = week[0];
                  const additions = week[1];
                  const deletions = Math.abs(week[2]);

                  const date = new Date(
                    timestamp * 1000
                  ).toISOString().split('T')[0];

                  if (!weeklyStats[date]) {
                    weeklyStats[date] = {
                      additions: 0,
                      deletions: 0
                    };
                  }

                  weeklyStats[date].additions += additions;
                  weeklyStats[date].deletions += deletions;
                }

              } catch (error) {

                console.warn(
                  `Could not fetch code frequency for ${repo.name}:`,
                  error.message
                );

              }
            }

            return Object.entries(weeklyStats)
              .map(([week, stats]) => ({
                week,
                additions: stats.additions,
                deletions: stats.deletions
              }))
              .sort(
                (a, b) =>
                  new Date(a.week) - new Date(b.week)
              );
          }


          async function fetchStats() {

            console.log(
              `Fetching GitHub statistics for ${username}...`
            );

            const data = await fetchUserStats();

            const user = data.user;

            if (!user) {
              throw new Error(
                `GitHub user '${username}' not found`
              );
            }


            /*
             * Repository statistics
             */

            let totalStars = 0;
            let totalForks = 0;

            const repositories = [];

            const languageMap = {};


            for (const repo of user.repositories.nodes) {

              totalStars += repo.stargazerCount;
              totalForks += repo.forkCount;


              repositories.push({
                name: repo.name,
                url: repo.url,
                stars: repo.stargazerCount,
                forks: repo.forkCount
              });


              for (const lang of repo.languages.edges) {

                const name = lang.node.name;

                languageMap[name] =
                  (languageMap[name] || 0) + lang.size;
              }
            }


            /*
             * Weekly additions / deletions
             */

            console.log(
              'Fetching weekly additions/deletions...'
            );

            const weeklyCodeFrequency =
              await fetchWeeklyCodeFrequency(
                user.repositories.nodes
              );


            /*
             * REST API gives us public repository count
             * and following count.
             */

            console.log(
              'Fetching public repository and following counts...'
            );

            const profile = await githubRest(
              `/users/${username}`
            );


            /*
             * Final JSON
             */

            const stats = {

              username,

              name: user.name,

              followers:
                user.followers.totalCount,

              following:
                profile.following,

              publicRepositories:
                profile.public_repos,

              commits:
                user.contributionsCollection
                  .totalCommitContributions
                +
                user.contributionsCollection
                  .restrictedContributionsCount,

              prs:
                user.pullRequests.totalCount,

              issues:
                user.issues.totalCount,

              stars:
                totalStars,

              forks:
                totalForks,


              repositories,


              weeklyCodeFrequency,


              languages:
                Object.entries(languageMap)

                  .map(([name, size]) => ({
                    name,
                    size
                  }))

                  .sort(
                    (a, b) => b.size - a.size
                  )

            };


            fs.writeFileSync(
              'stats.json',
              JSON.stringify(stats, null, 2) + '\\n'
            );


            console.log(
              'Generated stats.json:'
            );

            console.log(
              JSON.stringify(stats, null, 2)
            );
          }


          fetchStats().catch(error => {

            console.error(error);

            process.exit(1);

          });

          EOF

          node get-stats.js
          rm get-stats.js

      - name: Commit and Push Changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add stats.json

          git diff --cached --quiet && exit 0

          git commit \
            -m "chore: update profile stats JSON [skip ci]"

          git push
